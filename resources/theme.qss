/* Inventario — tema propio (grafito + ambar), sin estilos nativos de Windows */

* {
    font-family: "Segoe UI", sans-serif;
    outline: none;
}

QMainWindow, QWidget#AppRoot {
    background-color: #15171C;
}

QWidget {
    color: #F5F1EA;
}

#SurfaceCard {
    background-color: #21242C;
    border: 1px solid #2E323C;
    border-radius: 14px;
}

#TitleLabel {
    font-size: 22px;
    font-weight: 600;
    color: #F5F1EA;
}

#SubtitleLabel {
    font-size: 13px;
    color: #A9AFBC;
}

#VersionLabel {
    font-size: 11px;
    color: #6B7080;
}

QPushButton#PrimaryButton {
    background-color: #3FA79A;
    color: #082220;
    border: none;
    border-radius: 8px;
    padding: 10px 22px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background-color: #57C2B4;
}

QPushButton#PrimaryButton:pressed {
    background-color: #2D8377;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #2E323C;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #3A3F4B;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* --- Rail de navegacion --- */

#NavRail {
    background-color: #1B1E24;
    border-right: 1px solid #2E323C;
}

#NavList {
    background: transparent;
    border: none;
    font-size: 13px;
}

#NavList::item {
    color: #A9AFBC;
    padding: 10px 14px;
    border-radius: 8px;
    margin: 2px 0;
}

#NavList::item:hover {
    background-color: #21242C;
    color: #F5F1EA;
}

#NavList::item:selected {
    background-color: #123531;
    color: #57C2B4;
    font-weight: 600;
}

/* --- KPI --- */

#KpiValueLabel {
    font-size: 26px;
    font-weight: 700;
    color: #F5F1EA;
}

/* --- Botones secundarios --- */

QPushButton {
    background-color: #21242C;
    color: #F5F1EA;
    border: 1px solid #2E323C;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 13px;
}

QPushButton:hover:enabled {
    background-color: #262A33;
    border-color: #3A3F4B;
}

QPushButton:disabled {
    color: #6B7080;
}

/* --- Campos de entrada --- */

QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox {
    background-color: #1B1E24;
    border: 1px solid #2E323C;
    border-radius: 8px;
    padding: 6px 10px;
    color: #F5F1EA;
    selection-background-color: #3FA79A;
}

QLineEdit:focus, QComboBox:focus, QDoubleSpinBox:focus, QSpinBox:focus {
    border-color: #3FA79A;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #21242C;
    border: 1px solid #2E323C;
    color: #F5F1EA;
    selection-background-color: #123531;
    selection-color: #57C2B4;
}

/* --- Tabla de inventario --- */

QTableView {
    background-color: #15171C;
    alternate-background-color: #191B21;
    gridline-color: #2E323C;
    border: 1px solid #2E323C;
    border-radius: 10px;
    selection-background-color: #123531;
    selection-color: #F5F1EA;
}

QTableView::item {
    padding: 6px 10px;
    border: none;
}

QHeaderView::section {
    background-color: #1B1E24;
    color: #A9AFBC;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #2E323C;
    font-weight: 600;
}

/* --- Dialogos --- */

QDialog {
    background-color: #21242C;
}

QLabel {
    background: transparent;
}

QMessageBox {
    background-color: #21242C;
}

/* --- Barra de menu y menus desplegables --- */

QMenuBar {
    background-color: #15171C;
    color: #A9AFBC;
    padding: 2px 6px;
    border-bottom: 1px solid #2E323C;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #21242C;
    color: #F5F1EA;
}

QMenu {
    background-color: #21242C;
    color: #F5F1EA;
    border: 1px solid #2E323C;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 24px 7px 12px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #123531;
    color: #57C2B4;
}

QMenu::separator {
    height: 1px;
    background: #2E323C;
    margin: 6px 4px;
}

/* --- Progreso de descarga --- */

QProgressBar {
    background-color: #1B1E24;
    border: 1px solid #2E323C;
    border-radius: 6px;
    text-align: center;
    color: #F5F1EA;
}

QProgressBar::chunk {
    background-color: #3FA79A;
    border-radius: 5px;
}

QTextEdit {
    background-color: #1B1E24;
    border: 1px solid #2E323C;
    border-radius: 8px;
    color: #F5F1EA;
}
